# ==============================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon Serverless PostgreSQL or local SQLite)
# Example Neon PostgreSQL:
# postgresql://<user>:<password>@<endpoint-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# If left blank or left as placeholder, the system defaults to local SQLite (sqlite:///./dev.db)
DATABASE_URL=postgresql://your_neon_user:your_neon_password@ep-your-instance.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
PRODUCTION=false

# Email SMTP Settings (For sending authentication OTPs via Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
myGMAIL=your_email@gmail.com
password=your_16_character_gmail_app_password

# Cloudinary Storage (For storing raw & AI-cleaned CSV files with public URLs)
# Create a free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Cleaning Engine (LangGraph & LLM)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Optional Model Providers (if extended or switched)
GOOGLE_API_KEY=your_google_gemini_api_key
HF_TOKEN=your_huggingface_token

